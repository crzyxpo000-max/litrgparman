<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet izni YOK: uygulama tamamen çevrimdışıdır. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Zamanlayıcı bitişi: ekran kilitliyken de tam zamanında haber vermek için. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Germe rutini: ekran kapansa da süren ön plan servisi ve işlemciyi uyanık tutan kilit. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Health Connect'ten yalnızca OKUMA (isteğe bağlı; Ayarlar'dan açılır). Veri telefondan çıkmaz. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- Health Connect uygulamasını görebilmek için (Android 13 ve öncesi). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- allowBackup kapalı: veri Google hesabına yedeklenmez; yedek Ayarlar'dan JSON olarak alınır. -->
    <application
        android:name=".ZincirUygulamasi"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/veri_cikarma_kurallari"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zincir">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect'in istediği "bu veriyi neden okuyorsun" sayfası. -->
        <activity
            android:name=".saglik.GizlilikActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".saglik.GizlilikActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Yerel hatırlatmalar: alarm çalınca ve telefon yeniden başlayınca çalışır. -->
        <receiver
            android:name=".bildirim.HatirlatmaAlici"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Germe rutini sürerken çalışan ön plan servisi (bildirim çubuğunda kalan süreyi gösterir). -->
        <service
            android:name=".bildirim.GermeServisi"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Germe rutini zamanlayicisi: adim gecislerinde titresim" />
        </service>

        <!-- Yedek dosyasını başka uygulamalarla paylaşabilmek için. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosya"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>
    </application>
</manifest>
