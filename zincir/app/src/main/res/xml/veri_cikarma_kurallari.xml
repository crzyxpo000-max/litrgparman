<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: veri Google hesabına (buluta) yedeklenmez. Yedek, Ayarlar'dan JSON olarak alınır. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
