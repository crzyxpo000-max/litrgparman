    <string name="help_status">Status</string>
    <string name="tip_choices">Tags show what a choice needs; percentages, your odds. Details: (i)</string>
    <string name="tip_hub">Everything you do costs one action. When you\'re out, make camp to end the day.</string>
    <string name="tip_combat">Tap an enemy to target it. Long-press for true stats.</string>
    <string name="tip_status">A • on the Stats tab means you have points to spend.</string>
    <string name="tip_more">Each tile opens its own page.</string>

    <string name="help_req_term">Tags like [PER 6]</string>
    <string name="help_req">The choice needs at least that much of the stat (here, Perception 6). If you don\'t meet it, the choice shows up locked.</string>
    <string name="help_odds_term">Percentages like 45%</string>
    <string name="help_odds">Your odds on a skill check. A red percentage is one shot only: fail it and the choice closes. A white one can be retried.</string>
    <string name="help_kind_term">[Conceal] · [Reveal]</string>
    <string name="help_kind">Hide your power or show it. Revealing pulls your public level up to your real one and raises Attention; concealing keeps Attention low.</string>
    <string name="help_voices_term">Colored lines</string>
    <string name="help_voices">Blue cards are the System talking. Purple, glitchy text is Echo. Teal lines are insights only you can see; pink lines are your companions weighing in.</string>
    <string name="help_earlier_term">Earlier scenes</string>
    <string name="help_earlier">The screen only shows the current scene. Use the button at the top to reread what came before and what you chose.</string>
    <string name="help_actions_term">Actions left</string>
    <string name="help_actions">You get a limited number of actions per day. Every opportunity, exploring, training, resting, Gate, Spire floor, and trip costs one.</string>
    <string name="help_tension_term">● to ●●●●</string>
    <string name="help_tension">How tense an opportunity is: green is low-key, red is dangerous with heavy consequences.</string>
    <string name="help_danger_term">Danger</string>
    <string name="help_danger">How dangerous your current area is (0–100). The higher it gets, the tougher the encounters and the more often Gates open.</string>
    <string name="help_free_term">Explore · Train · Rest</string>
    <string name="help_free" formatted="false">Explore: an event or encounter in the area. Train: a bit of XP and Daily Quest progress. Rest: restores 40% of your HP and MP and lowers Attention a little.</string>
    <string name="help_gates_term">Gates</string>
    <string name="help_gates">Open dungeon Gates. When a Gate\'s timer runs out it breaks and the area pays for it; go in and clear it first.</string>
    <string name="help_tower_term">Spire ★</string>
    <string name="help_tower">Each climb is one floor. Floors marked ★ are story floors.</string>
    <string name="stance_all_out_desc">Deal 30% more damage, take 25% more. No stamina recovery.</string>
    <string name="stance_measured_desc">Balanced. Recover 5 stamina each turn.</string>
    <string name="stance_defensive_desc">Deal 30% less damage, take 40% less. Recover 12 stamina each turn.</string>
    <string name="effort_desc" formatted="false">Each effort level adds +12% damage and +5% to hit, and costs 8 stamina per level.</string>
    <string name="help_target_term">Targeting</string>
    <string name="help_target">Tap an enemy card to target it. Long-press for its true stats and weak spot.</string>
    <string name="help_actions_combat_term">Analyze · Environment · Talk</string>
    <string name="help_actions_combat">Analyze reveals an enemy\'s weak spot. Environment uses something on the battlefield (ceiling, water, flammables). Talk only works on intelligent enemies.</string>
    <string name="help_grade_term">Grade (F → S)</string>
    <string name="help_grade">Your power bracket: E at level 25, D at 50, C at 100, B at 200, A at 400, S at 800.</string>
    <string name="help_public_term">Public level</string>
    <string name="help_public">The level everyone else thinks you are. Only you know the real one; revealing your power closes the gap.</string>
    <string name="help_attention_term">Attention</string>
    <string name="help_attention">How much you stand out (0–100). Growing fast and showing off raise it; at its thresholds, hunters and greater beings take notice.</string>
    <string name="help_corruption_term">Corruption</string>
    <string name="help_corruption">Builds as you use dark and cursed powers. At its thresholds, it changes you.</string>
    <string name="help_points_term">Free points</string>
    <string name="help_points">You earn them as you level up. Spend them with +, then lock them in with Confirm. Once confirmed, there\'s no undo.</string>
    <string name="help_morality_term">Morality axes</string>
    <string name="help_morality">Your choices move three axes between −100 and +100. Endings, titles, and how people see you all depend on them.</string>

