<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulut yedeği ve cihazdan cihaza aktarım. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="saves/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="saves/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
